# syntax=docker/dockerfile:1.6
# RED cockpit image (ADR 0012, ADR 0013; SPEC.md sections 8, 10 and 13 condition 9).
#
# Builds the absorbed OpenExecutive UI (`vendor/openexecutive/packages/ui`) as
# the single RED shell (ADR 0013). The fork is absorbed (ADR 0014): its tracked
# source already carries the RED rebrand, so the image matches the repository
# with no apply step.
#
# Runtime env: BACKEND_BASE_URL=http://redop-api:8000/openexecutive and
# BACKEND_SHARED_SECRET (the proxy sends x-api-key), AUTH_SECRET.
FROM node:22-alpine AS deps
WORKDIR /app
COPY vendor/openexecutive/packages/ui/package.json vendor/openexecutive/packages/ui/package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY vendor/openexecutive/packages/ui/ ./
ENV NEXT_TELEMETRY_DISABLED=1
# Keep Next.js below the 4Gi DinD build-container limit while leaving headroom
# for Docker and Alpine processes.
ENV NODE_OPTIONS=--max-old-space-size=3072
# next-auth needs an AUTH_SECRET at build; the real one is provided at runtime.
ENV AUTH_SECRET=build-only-secret
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001 -G nodejs

COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
