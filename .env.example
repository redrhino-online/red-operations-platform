# Local development environment for the RED Operations Platform harness.
#
# Copy to `.env` to override. The harness (ralph_cycle.sh) and `make check`
# load this file when present; an explicit environment value wins.
#
# Bring up the matching database first:
#   docker compose up -d postgres
#
# Exporting DATABASE_URL keeps the persistence adapter and migration tests
# running instead of skipping.

DATABASE_URL=postgresql://redops:redops@localhost:5432/redops

# Deployed prototype health check for the definition-of-done gate (make done).
# The Atlas cluster must serve the RED app at this internal host. The gate
# ([6/6], scripts/check_deployed_red_health.sh) requires the response to carry
# the RED identity marker (REDOP_RED_MARKER, default "RED Operations"), so a
# bare 200 from the OpenExecutive shell or any other app cannot satisfy
# condition 9. Change the path if the deployment exposes the RED health
# elsewhere. TLS uses the internal atlas-ca; REDOP_HEALTH_INSECURE=1 tells the
# gate to skip CA verification.
REDOP_HEALTH_URL=https://redop.atlas.lan/
REDOP_HEALTH_INSECURE=1
