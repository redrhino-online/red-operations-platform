# syntax=docker/dockerfile:1.6
# RED UI image (Q47; SPEC.md sections 8, 10 and 13 condition 9).
#
# Multi-stage build for the Next.js thin client. Produces a small runtime image
# that runs `node server.js` from the standalone output (see
# `frontend/next.config.ts`). The UI holds no RED business logic (ADR 0007); it
# calls the RED backend under `/red`. The root page carries the `RED Operations`
# identity marker the deployed-health gate requires.
FROM node:22-alpine AS deps
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
ENV NEXT_TELEMETRY_DISABLED=1
# ADR 0012: the cockpit owns the root, so the RED screens are served under a
# subpath. The chart passes /screens; empty for local builds.
ARG NEXT_PUBLIC_RED_BASE_PATH=""
ENV NEXT_PUBLIC_RED_BASE_PATH=$NEXT_PUBLIC_RED_BASE_PATH
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Run as non-root for defense in depth.
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001 -G nodejs

# Standalone output contains a minimal server.js plus the node_modules it
# actually needs. Static assets must be copied in separately.
COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
